# Copy this file to .env and change the values. .env is never committed.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=workshop
POSTGRES_DB=workshop
# Use a long random value, letters and digits only (it is placed inside a URL).
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- App ------------------------------------------------------------------
# Only needed when you run the app or db scripts OUTSIDE Docker (npm run dev).
# Inside Docker, docker-compose.yml builds this URL from the values above.
DATABASE_URL=postgres://workshop:change-me-to-a-long-random-value@localhost:5432/workshop

# --- n8n (AI) ----------------------------------------------------------------
# n8n keeps its data in its own database in the same Postgres, under its own
# login. The app creates both on start. Letters and digits only for the password.
# Generate with:  openssl rand -hex 24
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-to-a-long-random-value
# Encrypts the credentials saved inside n8n. Set it once and NEVER change it —
# with a different key n8n can no longer read its saved credentials.
# Generate with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-value
# Public address of the n8n editor (no https://). Create a proxy host for it in
# NGINX Proxy Manager that forwards to n8n, port 5678.
N8N_HOST=n8n.example.com

# Internal webhook URLs the app calls when a new request is saved. Leave empty
# until the n8n workflows exist: requests are then saved with an empty AI field.
# They are used only on the server and never reach the browser. Once the
# workflows are active, the values look like:
#   http://n8n:5678/webhook/repair-diagnosis
#   http://n8n:5678/webhook/modification-summary
N8N_REPAIR_WEBHOOK_URL=
N8N_MODIFICATION_WEBHOOK_URL=
# Optional shared secret, sent to n8n as the x-webhook-secret header.
N8N_WEBHOOK_SECRET=

# --- Agent API (/api/agent/*) -----------------------------------------------
# n8n must send this value in the x-agent-key header on every call
# (inside Docker the API is at http://app:3000/api/agent).
# At least 32 characters; while it is empty the agent API answers 503.
# Generate with:  openssl rand -hex 32
AGENT_API_KEY=change-me-to-a-long-random-value

# --- Admin login (/admin) -----------------------------------------------------
ADMIN_EMAIL=owner@example.com
# Only the HASH of the password is stored. Create it with:
#   npm run admin:hash -- "your password"
# and paste the whole line it prints here.
ADMIN_PASSWORD_HASH=paste-the-output-of-npm-run-admin-hash-here
# Signs the login cookie. Generate with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-value
